// Custom default layout — replaces Zellij's built-in bars with zjstatus:
//   TOP bar:     tabs (left) · clock (center) · current-mode pill (right)
//                The active tab turns teal while a pane is fullscreen (zoomed),
//                so the bottom row can stay free.
//
// zjstatus is downloaded + cached from its GitHub release on first run (needs
// network the first time). Pinned to v0.24.0; bump the URL to update.
//
// NOTE: the clock uses datetime_timezone below — change it to your IANA zone if
// the time looks off (e.g. "Europe/London", "America/New_York").

layout {
    // ── TOP bar: tabs · clock · session ─────────────────────────────────────
    pane_template name="top_bar" borderless=true {
        plugin location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
                // format_space is the fill between the left/center/right groups;
                // it MUST be non-empty (with the bar bg) or center/right collapse.
                format_space  "#[bg=#181825]"
                format_left   "{tabs}"
                format_center "{datetime}"
                format_right  "{mode}"

                // Right side shows the current mode as a pill. Colors mirror the
                // cheatsheet's per-section badge (dark text #11111b on the section
                // color). tmux is labeled "Create" since it's the create menu.
                mode_normal      "#[fg=#11111b,bg=#89b4fa,bold]  Normal  "
                mode_locked      "#[fg=#11111b,bg=#f38ba8,bold]  Locked  "
                mode_pane        "#[fg=#11111b,bg=#fab387,bold]  Pane  "
                mode_tab         "#[fg=#11111b,bg=#cba6f7,bold]  Tab  "
                mode_resize      "#[fg=#11111b,bg=#94e2d5,bold]  Resize  "
                mode_move        "#[fg=#11111b,bg=#f9e2af,bold]  Move  "
                mode_scroll      "#[fg=#11111b,bg=#a6adc8,bold]  Scroll  "
                mode_search      "#[fg=#11111b,bg=#a6adc8,bold]  Search  "
                mode_entersearch "#[fg=#11111b,bg=#a6adc8,bold]  Search  "
                mode_session     "#[fg=#11111b,bg=#f5c2e7,bold]  Session  "
                mode_tmux        "#[fg=#11111b,bg=#a6e3a1,bold]  Create  "
                mode_renametab   "#[fg=#11111b,bg=#cba6f7,bold]  Rename Tab  "
                mode_renamepane  "#[fg=#11111b,bg=#fab387,bold]  Rename Pane  "

                // Tabs — subtle block for inactive, bright block for active, with
                // trailing spaces as separators so they don't look cut. The active
                // tab turns teal while it holds a fullscreen (zoomed) pane — the
                // only fullscreen cue now that the bottom bar is gone.
                tab_normal            "#[fg=#7f849c,bg=#313244] {index} {name} #[bg=#181825] "
                tab_active            "#[fg=#1e1e2e,bg=#89b4fa,bold] {index} {name} #[bg=#181825] "
                tab_active_fullscreen "#[fg=#11111b,bg=#89dceb,bold] {index} {name} zoom #[bg=#181825] "

                // Clock (center).
                datetime          "#[fg=#a6adc8,bg=#181825,bold] {format} "
                datetime_format   "%a %H:%M"
                datetime_timezone "Asia/Jerusalem"
        }
    }

    // Base tab: top bar + panes. New tabs use this. There is no bottom bar —
    // keybinding hints live in the `Ctrl Alt h` floating cheatsheet (see the header).
    // (size=1 lives at the use site — pane_template definitions reject `size`.)
    default_tab_template {
        top_bar size=1
        children
    }

    // Same structure as a named template so the swap layouts below can wrap the
    // top bar around whichever arrangement they snap the panes into.
    tab_template name="ui" {
        top_bar size=1
        children
    }

    // ── Swap layouts ────────────────────────────────────────────────────────
    // "Relayout" (Alt ] / Alt [ / Alt r) cycles panes through these arrangements.
    // max_panes/min_panes pick a sensible variant for the current pane count.
    swap_tiled_layout name="vertical" {
        ui max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        ui max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        ui max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        ui max_panes=4 {
            pane
            pane
        }
        ui max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="stacked" {
        ui min_panes=4 {
            pane stacked=true { children; }
        }
    }

    swap_tiled_layout name="half-stacked" {
        ui min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }
}
