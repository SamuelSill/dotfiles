{
  "triggers": ["<leader>", "g"],
  "branch_marker": ":",
  "breadcrumb_separator": "▏",

  "pretty": {
    "<A-c>": "A-c",
    "<A-s>": "A-s",
    "<C-l>": "C-l",
    "<C-]>": "C-]"
  },

  "lines": [
    { "bg": "#3a4d73", "bg_alt": "#2b3a55" }
  ],

  "highlights": {
    "key":    { "fg": "#a6e3a1", "bold": true },
    "desc":   { "fg": "#cdd6f4" },
    "branch": { "fg": "#89b4fa", "bold": true },
    "title":  { "fg": "#f5c2e7", "bold": true },
    "sep":    { "fg": "#585b70" }
  },

  "bindings": [
    ["gb", "block name"],

    ["<leader>fg", "grep (+glob)"],
    ["<leader>fr", "find/replace"],
    ["<leader>fb", "open files"],
    ["<leader>fs", "symbol (project)"],
    ["<leader>fS", "symbol (file)"],

    ["<leader>rn", "rename"],
    ["<leader>ca", "code action"],
    ["<leader>ci", "add import"],

    ["<leader>dd", "show error"],
    ["<leader>dv", "toggle inline"],

    ["<leader>gb", "blame line"],
    ["<leader>gl", "line history"],
    ["<leader>gc", "line change"],
    ["<leader>gr", "restore line"],
    ["<leader>gs", "stage hunk/sel"],
    ["<leader>gxo", "conflict: ours"],
    ["<leader>gxt", "conflict: theirs"],
    ["<leader>gxb", "conflict: both"],
    ["<leader>gxn", "conflict: none"],

    ["<leader>hu", "base types"],
    ["<leader>hd", "derived types"],
    ["<leader>hi", "implementors"],

    ["<leader>yp", "rel path"],
    ["<leader>yP", "full path"]
  ],

  "groups": [
    ["<leader>",  "menu", 0],
    ["g",         "goto", 0],
    ["<leader>f", "find"],
    ["<leader>r", "rename"],
    ["<leader>g", "git"],
    ["<leader>gx", "conflict"],
    ["<leader>h", "hierarchy"],
    ["<leader>y", "yank"],
    ["<leader>d", "diagnostics"],
    ["<leader>c", "code"]
  ],

  "visual": {
    "bindings": [
      ["~", "toggle case", 1],
      ["<A-c>", "change case", 1],
      ["<A-s>", "sub sel", 1],
      ["s", "surround +pair", 1]
    ]
  },

  "insert": {
    "bindings": [
      ["<C-l>", "copilot ✓", 2],
      ["<C-]>", "copilot dismiss", 2]
    ]
  }
}
