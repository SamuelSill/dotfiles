{
  "triggers": ["<leader>", "g"],
  "branch_marker": "›",
  "breadcrumb_separator": "▏",

  "pretty": {
    "<leader>": "SPC",
    "<CR>": "↵",
    "<Tab>": "⇥",
    "<Esc>": "ESC",
    "<A-J>": "A-S-j",
    "<A-K>": "A-S-k",
    "<A-f>": "A-f",
    "<A-s>": "A-s",
    "<S-Tab>": "⇧⇥",
    "<C-Space>": "C-Spc",
    "<C-f>": "C-f",
    "<C-b>": "C-b",
    "<C-l>": "C-l",
    "<C-]>": "C-]"
  },

  "lines": [
    { "bg": "#3a4d73", "bg_alt": "#2b3a55" },
    { "bg": "#4f3f6e", "bg_alt": "#3b2f52" }
  ],

  "highlights": {
    "key":    { "fg": "#a6e3a1", "bold": true },
    "desc":   { "fg": "#cdd6f4" },
    "branch": { "fg": "#89b4fa", "bold": true },
    "title":  { "fg": "#f5c2e7", "bold": true },
    "sep":    { "fg": "#585b70" }
  },

  "bindings": [
    ["*", "search word", 1],
    [":%s/x/y/g", "replace in file", 1],
    ["<A-J>", "add cursor ↓", 1],
    ["<A-K>", "add cursor ↑", 1],

    ["<leader>mn", "add next match"],
    ["<leader>mp", "add prev match"],

    ["f", "→ char", 2],
    ["F", "← char", 2],
    ["t", "→ till char", 2],
    ["T", "← till char", 2],

    ["gd", "def"],
    ["gr", "refs"],
    ["gi", "impl"],
    ["g[", "back"],
    ["g]", "forward"],
    ["gh", "hdr/src"],
    ["gb", "block name"],

    ["<leader>e",  "explorer"],
    ["<leader>q",  "quit"],

    ["<leader>ff", "files"],
    ["<leader>fg", "grep (+glob)"],
    ["<leader>fr", "find/replace"],
    ["<leader>fb", "open files"],
    ["<leader>fh", "help"],
    ["<leader>fs", "symbol # (project)"],
    ["<leader>fS", "symbol @ (file)"],

    ["<leader>rn", "rename"],
    ["<A-f>",      "format doc"],
    ["<leader>ca", "code action"],
    ["<leader>ci", "add import"],
    ["<leader>?",  "all keys"],

    ["<leader>dd", "show error"],
    ["<leader>dv", "toggle inline"],

    ["<leader>gb", "blame line"],
    ["<leader>gl", "line history"],
    ["<leader>gc", "line change"],
    ["<leader>gr", "restore line"],
    ["<leader>gs", "stage hunk/sel"],
    ["<leader>gxo", "conflict: ours"],
    ["<leader>gxt", "conflict: theirs"],
    ["<leader>gxb", "conflict: both"],
    ["<leader>gxn", "conflict: none"],

    ["<leader>hu", "inherit: base types"],
    ["<leader>hd", "inherit: derived types"],
    ["<leader>hi", "implementors (overrides)"],

    ["<leader>yp", "rel path"],
    ["<leader>yP", "full path"]
  ],

  "groups": [
    ["<leader>",  "menu", 0],
    ["g",         "goto", 0],
    ["<leader>f", "find"],
    ["<leader>r", "rename"],
    ["<leader>g", "git"],
    ["<leader>gx", "conflict"],
    ["<leader>h", "hierarchy"],
    ["<leader>y", "yank"],
    ["<leader>d", "diagnostics"],
    ["<leader>c", "code"]
  ],

  "visual": {
    "bindings": [
      ["u", "lowercase", 1],
      ["U", "uppercase", 1],
      ["~", "toggle case", 1],
      [">", "indent", 1],
      ["<", "unindent", 1],
      ["<A-f>", "format sel", 1],
      ["<A-s>", "sub sel", 1],
      ["s", "surround +pair", 1],

      ["o", "other end", 2],
      ["i", "inside block", 2],
      ["a", "around block", 2],
      ["y", "yank", 2],
      ["d", "delete", 2],
      ["<A-j>", "move ↓", 2],
      ["<A-k>", "move ↑", 2]
    ]
  },

  "insert": {
    "bindings": [
      ["<Tab>", "next", 1],
      ["<S-Tab>", "prev", 1],
      ["<CR>", "accept", 1],
      ["<C-Space>", "open", 1],
      ["<C-f>", "docs ↓", 1],
      ["<C-b>", "docs ↑", 1],

      ["<C-l>", "copilot ✓", 2],
      ["<C-]>", "copilot dismiss", 2]
    ]
  }
}
